PR_REVIEW_ROLE=services
PR_REVIEW_CRON_SCHEDULE='* * * * *'
# One quorum pass per GitHub App installation. Each file is private and stays outside the repository.
# pr-review-quorum.env: App 4752010 on the thelarklan user account.
# thelarklanlabs.env: the organization App on thelarklanlabs.
QUORUM_CONFIG_FILES='$HOME/.config/pr-review/pr-review-quorum.env $HOME/.config/pr-review/thelarklanlabs.env'
PR_REVIEW_UPDATE_LOCK='$HOME/.cache/pr-review-quorum/update.lock'
