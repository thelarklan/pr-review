#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

explicit_provider_env=0
if [[ -n "${PR_REVIEW_PROVIDER_ENV_FILE:-}" ]]; then
    explicit_provider_env=1
    provider_env_file="$PR_REVIEW_PROVIDER_ENV_FILE"
else
    provider_env_file="$HOME/.config/pr-review/provider.env"
fi

if [[ -e "$provider_env_file" ]]; then
    if [[ ! -f "$provider_env_file" ]]; then
        printf 'pr-review-cron: provider env path is not a regular file: %s\n' "$provider_env_file" >&2
        exit 1
    fi
    if [[ -n "$(find "$provider_env_file" -maxdepth 0 -perm /077 -print -quit)" ]]; then
        printf 'pr-review-cron: provider env permissions are too broad; run chmod 600 on %s\n' "$provider_env_file" >&2
        exit 1
    fi
    set -a
    # shellcheck source=/dev/null
    source "$provider_env_file"
    set +a
elif (( explicit_provider_env == 1 )); then
    printf 'pr-review-cron: missing provider env file: %s\n' "$provider_env_file" >&2
    exit 1
fi

provider="${PR_REVIEW_PROVIDER:-}"
case "$provider" in
    codex | claude | gemini) ;;
    *)
        printf 'pr-review-cron: PR_REVIEW_PROVIDER must be codex, claude, or gemini\n' >&2
        exit 2
        ;;
esac

max_failures="${PR_REVIEW_MAX_FAILURES:-3}"
if [[ ! "$max_failures" =~ ^[1-9][0-9]*$ ]]; then
    printf 'pr-review-cron: PR_REVIEW_MAX_FAILURES must be a positive integer\n' >&2
    exit 2
fi

cleanup_interval="${PR_REVIEW_CLEANUP_INTERVAL_SECONDS:-3600}"
if [[ ! "$cleanup_interval" =~ ^(0|[1-9][0-9]*)$ ]]; then
    printf 'pr-review-cron: PR_REVIEW_CLEANUP_INTERVAL_SECONDS must be a non-negative integer\n' >&2
    exit 2
fi

git_base_url="${PR_REVIEW_GIT_BASE_URL:-https://github.com}"
git_base_url="${git_base_url%/}"
if [[ -z "$git_base_url" ]]; then
    printf 'pr-review-cron: PR_REVIEW_GIT_BASE_URL must not be empty\n' >&2
    exit 2
fi

review_path="${PR_REVIEW_PATH:-$PATH}"
if [[ "$review_path" == "CHANGE_ME" ]]; then
    printf 'pr-review-cron: replace PR_REVIEW_PATH=CHANGE_ME with the provider toolchain PATH\n' >&2
    exit 2
fi
export PATH="$HOME/.local/bin:$review_path"
export LC_ALL=C

pr_watch_bin="${PR_REVIEW_WATCH_BIN:-$script_dir/pr-watch}"
skill_dir="${PR_REVIEW_SKILL_DIR:-$script_dir/../.agents/skills/pr-code-review}"
skill_main_file="$skill_dir/SKILL.md"
skill_first_pass_file="$skill_dir/FIRST-PASS.md"
skill_delta_file="$skill_dir/DELTA-REVIEW.md"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/pr-review"
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/pr-review"
work_root="${PR_REVIEW_WORK_ROOT:-$HOME/.local/share/pr-review/work}"
repos_root="$work_root/repos"
prs_root="$work_root/prs"
log_file="$state_dir/cron.log"
state_file="$state_dir/pr-watch.seen"
failure_file="$state_dir/provider-failures"
last_alert_file="$state_dir/last-alert-key"
cleanup_stamp_file="$state_dir/last-cleanup"
owner="${PR_REVIEW_OWNER:-${PR_WATCH_OWNER:-thelarklan}}"
cohort="${PR_REVIEW_COHORT:-${PR_WATCH_COHORT:-}}"
# Opt-in label: when set, only pull requests with this label get an AI review.
review_label="${PR_REVIEW_LABEL:-${PR_WATCH_LABEL:-}}"
alert_repo="${PR_REVIEW_ALERT_REPO:-}"

mkdir -p -- "$state_dir" "$cache_dir" "$work_root" "$repos_root" "$prs_root"
touch -- "$log_file" "$state_file" "$failure_file"
if (( $(stat -c %s -- "$log_file") > 5242880 )); then
    tail -n 2000 -- "$log_file" >"$log_file.next"
    mv -f -- "$log_file.next" "$log_file"
fi
exec >>"$log_file" 2>&1

printf '\n[%s] %s watcher started\n' "$(date --iso-8601=seconds)" "$provider"
if [[ ! -x "$pr_watch_bin" ]]; then
    printf 'pr-review-cron: missing watcher executable %s\n' "$pr_watch_bin"
    exit 1
fi
for required_skill in "$skill_main_file" "$skill_first_pass_file" "$skill_delta_file"; do
    if [[ ! -f "$required_skill" ]]; then
        printf 'pr-review-cron: missing review skill file %s\n' "$required_skill"
        exit 1
    fi
done

authenticated=$(gh api user --jq '.login') || {
    printf 'pr-review-cron: cannot read the authenticated GitHub identity\n'
    exit 1
}
reviewer="${PR_REVIEW_REVIEWER:-$authenticated}"
if [[ "${authenticated,,}" != "${reviewer,,}" ]]; then
    printf 'pr-review-cron: authenticated as %s, expected %s\n' "$authenticated" "$reviewer"
    exit 1
fi

run_dir=$(mktemp -d "$cache_dir/run.XXXXXXXX")
work_file="$run_dir/work"
error_file="$run_dir/errors"
candidate_state="$run_dir/state.seen"
before_state="$run_dir/state.before"
delta_file="$run_dir/state.delta"
failure_next="$run_dir/provider-failures.next"
provider_out="$run_dir/provider.out"
alert_next="$run_dir/last-alert-key.next"
cleanup_stamp_next="$run_dir/last-cleanup.next"

cleanup() {
    rm -f -- "$work_file" "$error_file" "$candidate_state" "$before_state" \
        "$delta_file" "$failure_next" "$provider_out" "$alert_next" \
        "$cleanup_stamp_next" "${candidate_state}.lock"
    rmdir -- "$run_dir" 2>/dev/null || true
}
trap cleanup EXIT HUP INT TERM

sort -u -- "$state_file" >"$before_state"
cp -- "$before_state" "$candidate_state"

set +e
PR_WATCH_STATE="$candidate_state" \
DEV_TOOLS_PR_WATCH_STATE="$candidate_state" \
PR_WATCH_OWNER="$owner" \
PR_WATCH_COHORT="$cohort" \
PR_WATCH_LABEL="$review_label" \
PR_WATCH_REVIEWER="$reviewer" \
PR_WATCH_MAX_FOLLOWUPS="${PR_REVIEW_MAX_FOLLOWUPS:-2}" \
PR_WATCH_VERBOSE=1 \
"$pr_watch_bin" >"$work_file" 2>"$error_file"
watch_status=$?
set -e

cat -- "$error_file"
if (( watch_status != 0 )); then
    printf 'pr-review-cron: watcher failed with status %s\n' "$watch_status"
    exit "$watch_status"
fi

sort -u -- "$candidate_state" | comm -13 "$before_state" - >"$delta_file"

commit_item_state() {
    local item="$1"
    awk -v prefix="$item " 'index($0, prefix) == 1' "$delta_file" >>"$state_file"
    sort -u -o "$state_file" -- "$state_file"
}

failure_count() {
    local item="$1" head="$2"
    awk -v item="$item" -v head="$head" '
        $1 == item && $2 == head { print $3; found = 1; exit }
        END { if (!found) print 0 }
    ' "$failure_file"
}

record_failure() {
    local item="$1" head="$2" count
    count=$(failure_count "$item" "$head")
    count=$((count + 1))
    awk -v item="$item" -v head="$head" \
        '!($1 == item && $2 == head)' "$failure_file" >"$failure_next"
    printf '%s %s %s\n' "$item" "$head" "$count" >>"$failure_next"
    mv -f -- "$failure_next" "$failure_file"
    printf '%s\n' "$count"
}

clear_failures() {
    local item="$1" head="$2"
    awk -v item="$item" -v head="$head" \
        '!($1 == item && $2 == head)' "$failure_file" >"$failure_next"
    mv -f -- "$failure_next" "$failure_file"
}

prune_inactive_failures() {
    awk '
        NR == FNR { if (NF) active[$1] = 1; next }
        $1 in active
    ' "$work_file" "$failure_file" >"$failure_next"
    mv -f -- "$failure_next" "$failure_file"
}

prune_other_heads() {
    local item="$1" head="$2"
    awk -v item="$item" -v head="$head" \
        '!($1 == item && $2 != head)' "$failure_file" >"$failure_next"
    mv -f -- "$failure_next" "$failure_file"
}

is_newer_review() {
    local submitted="$1" review_id="$2" prev_submitted="$3" prev_id="$4"
    if [[ -z "$prev_submitted" || "$submitted" > "$prev_submitted" ]]; then
        return 0
    fi
    if [[ "$submitted" == "$prev_submitted" && "$review_id" =~ ^[0-9]+$ && "$prev_id" =~ ^[0-9]+$ ]]; then
        ((10#$review_id > 10#$prev_id)) && return 0
    fi
    return 1
}

was_push_dismissed_approval() {
    local repo="$1" number="$2" review_id="$3"
    local dismissed_rows dismissed_state dismissal_commit
    [[ -n "$review_id" ]] || return 1
    dismissed_rows=$(gh api --paginate -H 'Accept: application/vnd.github+json' \
        "/repos/$repo/issues/$number/timeline?per_page=100" \
        --jq ".[] | select(.event == \"review_dismissed\" and ((.dismissed_review.review_id // 0) | tostring) == \"$review_id\") | [((.dismissed_review.state // \"\") | ascii_downcase), (.dismissed_review.dismissal_commit_id // \"\")] | @tsv") || return 2
    while IFS=$'\t' read -r dismissed_state dismissal_commit; do
        if [[ "$dismissed_state" == "approved" && -n "$dismissal_commit" ]]; then
            return 0
        fi
    done <<<"$dismissed_rows"
    return 1
}

inspect_reviewer_state() {
    local repo="$1" number="$2" include_dismissed_context="${3:-1}"
    local rows review_id commit submitted state
    local active_id="" active_commit="" active_time="" active_state=""
    local decisive_id="" decisive_commit="" decisive_time="" decisive_state=""
    local prior_id="" prior_commit="" prior_state="" push_status=0
    local -A change_request_commits=()

    rows=$(gh api --paginate "/repos/$repo/pulls/$number/reviews?per_page=100" \
        --jq ".[] | select(((.user.login // \"\") | ascii_downcase) == \"${reviewer,,}\") | [((.id // 0) | tostring), (if (.commit_id // \"\") == \"\" then \"-\" else .commit_id end), (if (.submitted_at // \"\") == \"\" then \"-\" else .submitted_at end), (if (.state // \"\") == \"\" then \"-\" else (.state | ascii_upcase) end)] | @tsv") || return 1

    while IFS=$'\t' read -r review_id commit submitted state; do
        [[ "$commit" == "-" ]] && commit=""
        [[ "$submitted" == "-" ]] && submitted=""
        [[ "$state" == "-" ]] && state=""
        [[ -n "$review_id" && "$review_id" != "0" ]] || continue
        if [[ "$state" == "CHANGES_REQUESTED" ]]; then
            change_request_commits["${commit:-review-$review_id}"]=1
        fi
        if [[ "$state" != "DISMISSED" ]] &&
            is_newer_review "$submitted" "$review_id" "$active_time" "$active_id"; then
            active_id="$review_id"
            active_commit="$commit"
            active_time="$submitted"
            active_state="$state"
        fi
        if [[ "$state" == "APPROVED" || "$state" == "CHANGES_REQUESTED" || "$state" == "DISMISSED" ]] &&
            is_newer_review "$submitted" "$review_id" "$decisive_time" "$decisive_id"; then
            decisive_id="$review_id"
            decisive_commit="$commit"
            decisive_time="$submitted"
            decisive_state="$state"
        fi
    done <<<"$rows"

    if (( include_dismissed_context == 1 )); then
        if [[ "$decisive_state" == "DISMISSED" && -n "$decisive_id" ]] &&
            is_newer_review "$decisive_time" "$decisive_id" "$active_time" "$active_id"; then
            push_status=0
            was_push_dismissed_approval "$repo" "$number" "$decisive_id" || push_status=$?
            if (( push_status == 0 )); then
                prior_id="$decisive_id"
                prior_commit="$decisive_commit"
                prior_state="APPROVED (dismissed on push)"
            elif (( push_status == 2 )); then
                return 1
            else
                prior_id=""
                prior_commit=""
                prior_state="DISMISSED (manual)"
            fi
        elif [[ -n "$active_id" ]]; then
            prior_id="$active_id"
            prior_commit="$active_commit"
            prior_state="$active_state"
        fi
    fi

    # Line 7 counts the distinct head commits where this reviewer requested changes.
    printf '%s\n%s\n%s\n%s\n%s\n%s\n%s\n' \
        "$active_id" "$active_commit" "$prior_id" "$prior_commit" "$prior_state" "$active_state" \
        "${#change_request_commits[@]}"
}

read_pr_metadata() {
    local repo="$1" number="$2"
    gh api "/repos/$repo/pulls/$number" \
        --jq '(.head.sha // ""), (.base.ref // ""), (.base.sha // ""), (.html_url // "")'
}

read_skill_body() {
    local file="$1"
    awk '
        NR == 1 && $0 == "---" { in_frontmatter = 1; next }
        in_frontmatter && $0 == "---" { in_frontmatter = 0; skip_blank = 1; next }
        in_frontmatter { next }
        skip_blank && $0 == "" { skip_blank = 0; next }
        { skip_blank = 0; print }
    ' "$file"
}

prepare_pr_worktree() {
    local repo="$1" number="$2" base_ref="$3" current_head="$4"
    local repo_owner repo_name bare_repo effort_dir pr_worktree pr_scratch remote_url
    local clone_tmp="" fetched_head="" actual_head=""
    local -a git_auth_args=()

    if [[ "$repo" == *".."* ]]; then
        printf 'pr-review-cron: refusing unsafe repository name %s\n' "$repo" >&2
        return 1
    fi
    if ! git check-ref-format "refs/heads/$base_ref" >/dev/null 2>&1; then
        printf 'pr-review-cron: refusing unsafe base ref %s for %s#%s\n' "$base_ref" "$repo" "$number" >&2
        return 1
    fi

    repo_owner="${repo%/*}"
    repo_name="${repo#*/}"
    bare_repo="$repos_root/$repo_owner/$repo_name.git"
    effort_dir="$prs_root/${repo_owner}__${repo_name}__pr-${number}"
    pr_worktree="$effort_dir/repo"
    pr_scratch="$effort_dir/scratch"
    remote_url="$git_base_url/$repo.git"

    if [[ "$remote_url" == https://* ]]; then
        git_auth_args=(-c credential.helper= -c 'credential.helper=!gh auth git-credential')
    fi

    mkdir -p -- "$(dirname -- "$bare_repo")" "$effort_dir" "$pr_scratch"

    if [[ ! -d "$bare_repo" || "$(git -C "$bare_repo" rev-parse --is-bare-repository 2>/dev/null || true)" != "true" ]]; then
        rm -rf -- "$bare_repo"
        clone_tmp=$(mktemp -d "${bare_repo}.clone.XXXXXXXX")
        if ! git "${git_auth_args[@]}" clone --bare --no-tags -- "$remote_url" "$clone_tmp" >&2; then
            rm -rf -- "$clone_tmp"
            return 1
        fi
        mv -T -- "$clone_tmp" "$bare_repo"
    fi

    if ! git -C "$bare_repo" "${git_auth_args[@]}" fetch --no-tags "$remote_url" \
        "+refs/heads/$base_ref:refs/pr-review/bases/$number" \
        "+refs/pull/$number/head:refs/pr-review/heads/$number" >&2; then
        return 1
    fi

    fetched_head=$(git -C "$bare_repo" rev-parse "refs/pr-review/heads/$number^{commit}" 2>/dev/null || true)
    if [[ "$fetched_head" != "$current_head" ]]; then
        printf 'pr-review-cron: %s#%s head moved during fetch (expected %s, got %s)\n' \
            "$repo" "$number" "$current_head" "${fetched_head:-missing}" >&2
        return 1
    fi

    git -C "$bare_repo" worktree prune >&2
    if [[ -e "$pr_worktree" ]]; then
        if [[ ! -f "$pr_worktree/.git" || "$(git -C "$pr_worktree" rev-parse --is-inside-work-tree 2>/dev/null || true)" != "true" ]]; then
            rm -rf -- "$pr_worktree"
            git -C "$bare_repo" worktree prune >&2
        fi
    fi

    if [[ ! -e "$pr_worktree" ]]; then
        git -C "$bare_repo" worktree add --force --detach "$pr_worktree" "$current_head" >&2 || return 1
    else
        git -C "$pr_worktree" checkout --force --detach "$current_head" >&2 || return 1
    fi

    git -C "$pr_worktree" reset --hard "$current_head" >&2 || return 1
    git -C "$pr_worktree" clean -ffdx >&2 || return 1

    actual_head=$(git -C "$pr_worktree" rev-parse HEAD 2>/dev/null || true)
    if [[ "$actual_head" != "$current_head" ]]; then
        printf 'pr-review-cron: worktree HEAD mismatch for %s#%s (expected %s, got %s)\n' \
            "$repo" "$number" "$current_head" "${actual_head:-unknown}" >&2
        return 1
    fi

    printf 'repo=%s\nnumber=%s\nbare_repo=%s\n' "$repo" "$number" "$bare_repo" >"$effort_dir/pr.meta"
    printf '%s\n%s\n' "$pr_worktree" "$pr_scratch"
}

cleanup_closed_pr_worktrees() {
    local now last_cleanup=0 entry meta_repo meta_number meta_bare_repo pr_state
    local -a entries=()

    shopt -s nullglob
    entries=("$prs_root"/*)
    shopt -u nullglob
    (( ${#entries[@]} > 0 )) || return 0

    now=$(date +%s)
    if (( cleanup_interval > 0 )) && [[ -f "$cleanup_stamp_file" ]]; then
        last_cleanup=$(<"$cleanup_stamp_file")
        if [[ "$last_cleanup" =~ ^[0-9]+$ ]] && (( now - last_cleanup < cleanup_interval )); then
            return 0
        fi
    fi

    printf '%s\n' "$now" >"$cleanup_stamp_next"
    mv -f -- "$cleanup_stamp_next" "$cleanup_stamp_file"

    for entry in "${entries[@]}"; do
        [[ -d "$entry" && -f "$entry/pr.meta" ]] || continue
        meta_repo=$(awk -F= '$1 == "repo" { print substr($0, 6); exit }' "$entry/pr.meta")
        meta_number=$(awk -F= '$1 == "number" { print substr($0, 8); exit }' "$entry/pr.meta")
        if [[ ! "$meta_repo" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ || "$meta_repo" == *".."* || ! "$meta_number" =~ ^[0-9]+$ ]]; then
            continue
        fi
        meta_bare_repo="$repos_root/$meta_repo.git"
        pr_state=$(gh pr view "$meta_number" --repo "$meta_repo" --json state --jq '.state' 2>/dev/null || true)
        case "$pr_state" in
            MERGED | CLOSED)
                if [[ -n "$meta_bare_repo" && -d "$meta_bare_repo" ]]; then
                    git -C "$meta_bare_repo" worktree remove --force "$entry/repo" >/dev/null 2>&1 || true
                    git -C "$meta_bare_repo" worktree prune >/dev/null 2>&1 || true
                    git -C "$meta_bare_repo" update-ref -d "refs/pr-review/heads/$meta_number" >/dev/null 2>&1 || true
                    git -C "$meta_bare_repo" update-ref -d "refs/pr-review/bases/$meta_number" >/dev/null 2>&1 || true
                fi
                rm -rf -- "$entry"
                printf '[%s] cleaned up %s PR workspace %s#%s\n' \
                    "$(date --iso-8601=seconds)" "$pr_state" "$meta_repo" "$meta_number"
                ;;
        esac
    done
}

resolve_executable() {
    local configured="$1" fallback="$2"
    if [[ -n "$configured" ]]; then
        if [[ "$configured" == */* ]]; then
            [[ -x "$configured" ]] || return 1
            printf '%s\n' "$configured"
        else
            command -v "$configured"
        fi
    else
        command -v "$fallback"
    fi
}

run_provider() {
    local prompt="$1" pr_worktree="$2" pr_scratch="$3" executable driver
    local codex_model codex_effort claude_model claude_effort agy_model agy_effort
    local -a codex_args claude_args agy_args

    case "$provider" in
        codex)
            executable=$(resolve_executable "${PR_REVIEW_CODEX_BIN:-}" codex) || {
                printf 'pr-review-cron: Codex CLI is not installed\n' >&2
                return 127
            }
            codex_model="${PR_REVIEW_CODEX_MODEL:-gpt-6.2-sol}"
            codex_effort="${PR_REVIEW_CODEX_EFFORT:-high}"
            codex_args=(
                exec --ephemeral --approve-for-me --skip-git-repo-check
                --model "$codex_model"
            )
            if [[ -n "$codex_effort" ]]; then
                codex_args+=(--config "model_reasoning_effort=\"$codex_effort\"")
            fi
            codex_args+=(--add-dir "$pr_worktree" -- "$prompt")
            timeout --signal=TERM --kill-after=2m "${PR_REVIEW_TIMEOUT:-45m}" \
                "$executable" "${codex_args[@]}"
            ;;
        claude)
            executable=$(resolve_executable "${PR_REVIEW_CLAUDE_BIN:-}" claude) || {
                printf 'pr-review-cron: Claude CLI is not installed\n' >&2
                return 127
            }
            claude_model="${PR_REVIEW_CLAUDE_MODEL:-claude-opus-5-5}"
            claude_effort="${PR_REVIEW_CLAUDE_EFFORT:-high}"
            claude_args=(
                --print --permission-mode bypassPermissions
                --no-session-persistence --output-format text
                --model "$claude_model"
            )
            if [[ -n "$claude_effort" ]]; then
                claude_args+=(--effort "$claude_effort")
            fi
            claude_args+=(--add-dir "$pr_worktree" -- "$prompt")
            timeout --signal=TERM --kill-after=2m "${PR_REVIEW_TIMEOUT:-45m}" \
                "$executable" "${claude_args[@]}"
            ;;
        gemini)
            driver="${PR_REVIEW_GEMINI_DRIVER:-agy}"
            case "$driver" in
                gemini)
                    executable=$(resolve_executable "${PR_REVIEW_GEMINI_BIN:-}" gemini) || {
                        printf 'pr-review-cron: Gemini CLI is not installed\n' >&2
                        return 127
                    }
                    timeout --signal=TERM --kill-after=2m "${PR_REVIEW_TIMEOUT:-45m}" \
                        "$executable" --prompt "$prompt" --approval-mode yolo \
                        --output-format text
                    ;;
                agy)
                    executable=$(resolve_executable "${PR_REVIEW_GEMINI_BIN:-}" agy) || {
                        printf 'pr-review-cron: Antigravity CLI (agy) is not installed\n' >&2
                        return 127
                    }
                    agy_model="${PR_REVIEW_ANTIGRAVITY_MODEL:-gemini-4-neon-high}"
                    agy_effort="${PR_REVIEW_ANTIGRAVITY_EFFORT:-}"
                    agy_args=(
                        --dangerously-skip-permissions
                        --output-format text
                        --print-timeout "${PR_REVIEW_TIMEOUT:-45m}"
                        --model "$agy_model"
                    )
                    if [[ -n "$agy_effort" ]]; then
                        agy_args+=(--effort "$agy_effort")
                    fi
                    agy_args+=("--print=$prompt")
                    timeout --signal=TERM --kill-after=2m "${PR_REVIEW_TIMEOUT:-45m}" \
                        "$executable" "${agy_args[@]}"
                    ;;
                *)
                    printf 'pr-review-cron: PR_REVIEW_GEMINI_DRIVER must be gemini or agy\n' >&2
                    return 2
                    ;;
            esac
            ;;
    esac
}

find_health_issue() {
    local title="$1" issues_json
    issues_json=$(gh issue list --repo "$alert_repo" --state open --limit 100 --json number,title) || return 1
    jq -r --arg title "$title" '[.[] | select(.title == $title)] | first | .number // empty' <<<"$issues_json"
}

emit_health_alert() {
    local alert_key="$1" alert_summary="$2"
    local previous_key="" alert_title existing_issue alert_body

    [[ -n "$alert_repo" ]] || return 0
    if [[ -f "$last_alert_file" ]]; then
        previous_key=$(<"$last_alert_file")
    fi
    if [[ "$alert_key" == "$previous_key" ]]; then
        return 0
    fi

    alert_title="[bot-health] $provider ($reviewer) review alert"
    # shellcheck disable=SC2016 # Backticks are Markdown code spans.
    alert_body=$(printf 'Automated health alert for `%s` (`%s`) at `%s`.\n\n%s\n' \
        "$provider" "$reviewer" "$(date --iso-8601=seconds)" "$alert_summary")

    if ! existing_issue=$(find_health_issue "$alert_title"); then
        printf 'pr-review-cron: health alert lookup failed for %s\n' "$alert_repo"
        return 0
    fi

    if [[ -n "$existing_issue" ]]; then
        if ! gh issue comment "$existing_issue" --repo "$alert_repo" --body "$alert_body" >/dev/null; then
            printf 'pr-review-cron: health alert comment failed for %s#%s\n' "$alert_repo" "$existing_issue"
            return 0
        fi
    else
        if ! gh issue create --repo "$alert_repo" --title "$alert_title" --body "$alert_body" >/dev/null; then
            printf 'pr-review-cron: health alert creation failed for %s\n' "$alert_repo"
            return 0
        fi
    fi

    printf '%s\n' "$alert_key" >"$alert_next"
    mv -f -- "$alert_next" "$last_alert_file"
}

resolve_health_alert() {
    local alert_title existing_issue
    [[ -n "$alert_repo" && -f "$last_alert_file" ]] || return 0

    alert_title="[bot-health] $provider ($reviewer) review alert"
    if ! existing_issue=$(find_health_issue "$alert_title"); then
        printf 'pr-review-cron: health alert recovery lookup failed for %s\n' "$alert_repo"
        return 0
    fi

    if [[ -n "$existing_issue" ]]; then
        if ! gh issue close "$existing_issue" --repo "$alert_repo" \
            --comment "Resolved: $provider ($reviewer) completed a clean poll with no active failures or authentication warnings." >/dev/null; then
            printf 'pr-review-cron: health alert close failed for %s#%s\n' "$alert_repo" "$existing_issue"
            return 0
        fi
    fi

    rm -f -- "$last_alert_file"
}

skill_main_body=$(read_skill_body "$skill_main_file")
skill_first_pass_body=$(read_skill_body "$skill_first_pass_file")
skill_delta_body=$(read_skill_body "$skill_delta_file")

prune_inactive_failures

processed=0
failed=0
paused=0
auth_alert=0
declare -a alert_reasons=()
declare -a alert_lines=()
auth_pattern='Failed to authenticate|Failed to refresh token|sign-in can end|claude auth login|Please log out and sign in again|token expired|invalid_jwt'

while IFS= read -r item; do
    [[ -n "$item" ]] || continue
    if [[ ! "$item" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[0-9]+$ ]]; then
        printf 'pr-review-cron: refusing malformed work item: %s\n' "$item"
        failed=$((failed + 1))
        continue
    fi
    if grep -Fq "ESCALATE: $item " "$error_file"; then
        printf '[%s] %s requires human review; autonomous follow-ups stopped\n' \
            "$(date --iso-8601=seconds)" "$item"
        alert_reasons+=("watch-escalate:$item")
        alert_lines+=("- Escalated from watcher follow-up limit: $item")
        commit_item_state "$item"
        continue
    fi

    repo="${item%#*}"
    number="${item##*#}"
    set +e
    pr_meta_raw=$(read_pr_metadata "$repo" "$number")
    pr_meta_status=$?
    before_review_raw=$(inspect_reviewer_state "$repo" "$number" 1)
    before_review_status=$?
    set -e
    if ((pr_meta_status != 0 || before_review_status != 0)); then
        failed=$((failed + 1))
        printf 'pr-review-cron: preparation query failed for %s (head-status=%s, review-status=%s); provider not started\n' \
            "$item" "$pr_meta_status" "$before_review_status"
        continue
    fi
    mapfile -t pr_meta <<<"$pr_meta_raw"
    current_head="${pr_meta[0]:-}"
    base_ref="${pr_meta[1]:-}"
    base_sha="${pr_meta[2]:-}"
    pr_url="${pr_meta[3]:-}"
    if [[ -z "$current_head" || -z "$base_ref" ]]; then
        failed=$((failed + 1))
        printf 'pr-review-cron: incomplete pull-request metadata for %s; provider not started\n' "$item"
        continue
    fi

    mapfile -t before_review <<<"$before_review_raw"
    before_review_id="${before_review[0]:-}"
    prior_review_id="${before_review[2]:-}"
    prior_review_commit="${before_review[3]:-}"
    prior_review_state="${before_review[4]:-}"
    earlier_change_requests="${before_review[6]:-0}"

    prune_other_heads "$item" "$current_head"
    attempt_count=$(failure_count "$item" "$current_head")
    if ((attempt_count >= max_failures)); then
        paused=$((paused + 1))
        printf '[%s] %s at %s remains paused after %s unconfirmed attempt(s)\n' \
            "$(date --iso-8601=seconds)" "$item" "$current_head" "$attempt_count"
        continue
    fi

    set +e
    worktree_raw=$(prepare_pr_worktree "$repo" "$number" "$base_ref" "$current_head")
    worktree_status=$?
    set -e
    if ((worktree_status != 0)); then
        failed=$((failed + 1))
        printf 'pr-review-cron: workspace preparation failed for %s at %s; provider not started\n' \
            "$item" "$current_head"
        continue
    fi
    mapfile -t worktree_info <<<"$worktree_raw"
    pr_worktree="${worktree_info[0]:-}"
    pr_scratch="${worktree_info[1]:-}"

    review_mode="first-pass"
    branch_body="$skill_first_pass_body"
    diff_range="refs/pr-review/bases/$number...$current_head"
    delta_summary=""
    baseline_file="$(dirname -- "$pr_worktree")/review-baseline"
    merge_base=$(git -C "$pr_worktree" merge-base "refs/pr-review/bases/$number" "$current_head" || true)
    baseline_id="" baseline_ref="" baseline_merge_base=""
    if [[ -f "$baseline_file" ]]; then
        IFS=$'\t' read -r baseline_id baseline_ref baseline_merge_base <"$baseline_file" || true
    fi
    if [[ -n "$prior_review_commit" && -n "$merge_base" &&
        "$prior_review_id" == "$baseline_id" && "$base_ref" == "$baseline_ref" &&
        "$merge_base" == "$baseline_merge_base" &&
        ( "$prior_review_state" == "APPROVED" || "$prior_review_state" == "CHANGES_REQUESTED" ||
          "$prior_review_state" == "APPROVED (dismissed on push)" ) ]]; then
        if [[ "$prior_review_commit" == "$current_head" ]]; then
            review_mode="same-head-followup"
            branch_body="$skill_delta_body"
            diff_range="refs/pr-review/bases/$number...$current_head"
        elif git -C "$pr_worktree" cat-file -e "${prior_review_commit}^{commit}" 2>/dev/null &&
            git -C "$pr_worktree" merge-base --is-ancestor "$prior_review_commit" "$current_head" 2>/dev/null; then
            review_mode="delta-re-review"
            branch_body="$skill_delta_body"
            diff_range="$prior_review_commit..$current_head"
            delta_commit_count=$(git -C "$pr_worktree" rev-list --count "$diff_range" 2>/dev/null || printf '0')
            delta_stat=$(git -C "$pr_worktree" diff --stat "$diff_range" 2>/dev/null | head -n 40 || true)
            delta_summary=$(printf 'Commits since prior review: %s\nDelta diffstat (%s):\n%s' \
                "$delta_commit_count" "$diff_range" "${delta_stat:-none}")
        else
            review_mode="rebased-re-review"
            branch_body="$skill_first_pass_body"
            diff_range="refs/pr-review/bases/$number...$current_head"
        fi
    fi
    if [[ -z "$delta_summary" ]]; then
        full_stat=$(git -C "$pr_worktree" diff --stat "$diff_range" 2>/dev/null | head -n 40 || true)
        delta_summary=$(printf 'Diffstat (%s):\n%s' "$diff_range" "${full_stat:-none}")
    fi

    prior_context_line="Prior review by $reviewer: none"
    if [[ -n "$prior_review_id" ]]; then
        prior_context_line="Prior review by $reviewer: id=$prior_review_id state=${prior_review_state:-unknown} commit=${prior_review_commit:-unknown}"
    elif [[ -n "$prior_review_state" ]]; then
        prior_context_line="Prior review by $reviewer: state=$prior_review_state (full review required)"
    fi

    prompt="$(printf '%s\n' \
        "This is an autonomous scheduled pull-request review for $item, running as GitHub identity $reviewer." \
        "" \
        "## Run context" \
        "- Pull request: $item (${pr_url:-https://github.com/$repo/pull/$number})" \
        "- Review mode: $review_mode" \
        "- Base branch: origin/$base_ref (${base_sha:-unknown})" \
        "- Target head SHA: $current_head" \
        "- Prepared git worktree (clean detached HEAD): $pr_worktree" \
        "- Scratch directory (outside repo): $pr_scratch" \
        "- $prior_context_line" \
        "- Earlier change requests by $reviewer on this pull request: $earlier_change_requests" \
        "- Primary diff range: $diff_range" \
        "- Required final line of the GitHub review body: _reviewed from: $provider-wsl-cron_" \
        "" \
        "$delta_summary" \
        "" \
        "Use the prepared worktree directly; do not re-clone the repository. Keep any temporary files in $pr_scratch or /tmp." \
        "" \
        "$skill_main_body" \
        "" \
        "$branch_body")"

    printf '[%s] reviewing %s at %s (mode=%s, worktree=%s)\n' \
        "$(date --iso-8601=seconds)" "$item" "$current_head" "$review_mode" "$pr_worktree"
    : >"$provider_out"
    set +e
    (cd -- "$pr_scratch" && run_provider "$prompt" "$pr_worktree" "$pr_scratch") </dev/null >"$provider_out" 2>&1
    provider_status=$?
    set -e
    cat -- "$provider_out"

    if grep -Eiq "$auth_pattern" "$provider_out"; then
        auth_alert=1
        auth_line=$(grep -Eim 1 "$auth_pattern" "$provider_out" | cut -c 1-200)
        alert_reasons+=("auth:$provider")
        alert_lines+=("- Authentication diagnostic for \`$provider\`: \`$auth_line\`")
    fi

    set +e
    after_head=$(gh pr view "$number" --repo "$repo" --json headRefOid --jq '.headRefOid')
    after_head_status=$?
    after_review_raw=$(inspect_reviewer_state "$repo" "$number" 0)
    after_review_status=$?
    set -e
    mapfile -t after_review <<<"$after_review_raw"
    after_review_id="${after_review[0]:-}"
    after_review_commit="${after_review[1]:-}"
    after_review_state="${after_review[5]:-}"
    if (( provider_status == 0 && after_head_status == 0 && after_review_status == 0 )) &&
        [[ -n "$after_review_id" ]] &&
        [[ "$after_review_id" != "$before_review_id" ]] &&
        [[ "$after_review_commit" == "$current_head" && "$after_head" == "$current_head" ]]; then
        if [[ "$after_review_state" == "APPROVED" || "$after_review_state" == "CHANGES_REQUESTED" ]]; then
            printf '%s\t%s\t%s\n' "$after_review_id" "$base_ref" "$merge_base" >"$baseline_file"
        fi
        commit_item_state "$item"
        clear_failures "$item" "$current_head"
        processed=$((processed + 1))
        printf '[%s] confirmed review %s for %s at %s\n' \
            "$(date --iso-8601=seconds)" "$after_review_id" "$item" "$after_head"
    else
        failed=$((failed + 1))
        attempt_count=$(record_failure "$item" "$current_head")
        if ((after_head_status != 0 || after_review_status != 0)); then
            printf 'pr-review-cron: confirmation query failed for %s (head-status=%s, review-status=%s)\n' \
                "$item" "$after_head_status" "$after_review_status"
        fi
        printf 'pr-review-cron: %s was not confirmed (provider=%s, before=%s, after=%s, head=%s)\n' \
            "$item" "$provider_status" "${before_review_id:-none}" "${after_review_id:-none}" \
            "${after_head:-unknown}"
        if ((attempt_count >= max_failures)); then
            commit_item_state "$item"
            printf 'pr-review-cron: ESCALATE: %s failed %s consecutive attempt(s) at %s; automatic retries paused\n' \
                "$item" "$attempt_count" "$current_head"
            alert_reasons+=("escalate:$item@$current_head")
            alert_lines+=("- Review paused after $attempt_count failure(s): $item at \`$current_head\`")
        fi
    fi
done <"$work_file"

cleanup_closed_pr_worktrees

if (( ${#alert_reasons[@]} > 0 )); then
    alert_fingerprint=$(printf '%s\n' "${alert_reasons[@]}" | LC_ALL=C sort -u | paste -sd ',' -)
    alert_summary=$(printf '%s\n' "${alert_lines[@]}" | awk '!seen[$0]++')
    emit_health_alert "$alert_fingerprint" "$alert_summary"
elif (( failed == 0 && paused == 0 && auth_alert == 0 )); then
    resolve_health_alert
fi

printf '[%s] %s watcher finished: %s confirmed, %s failed, %s paused\n' \
    "$(date --iso-8601=seconds)" "$provider" "$processed" "$failed" "$paused"
(( failed == 0 ))
