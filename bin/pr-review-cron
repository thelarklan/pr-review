#!/usr/bin/env bash
set -euo pipefail

script_dir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)

explicit_provider_env=0
if [[ -n "${PR_REVIEW_PROVIDER_ENV_FILE:-}" ]]; then
    explicit_provider_env=1
    provider_env_file="$PR_REVIEW_PROVIDER_ENV_FILE"
else
    provider_env_file="$HOME/.config/pr-review/provider.env"
fi

if [[ -e "$provider_env_file" ]]; then
    if [[ ! -f "$provider_env_file" ]]; then
        printf 'pr-review-cron: provider env path is not a regular file: %s\n' "$provider_env_file" >&2
        exit 1
    fi
    if [[ -n "$(find "$provider_env_file" -maxdepth 0 -perm /077 -print -quit)" ]]; then
        printf 'pr-review-cron: provider env permissions are too broad; run chmod 600 on %s\n' "$provider_env_file" >&2
        exit 1
    fi
    set -a
    # shellcheck source=/dev/null
    source "$provider_env_file"
    set +a
elif (( explicit_provider_env == 1 )); then
    printf 'pr-review-cron: missing provider env file: %s\n' "$provider_env_file" >&2
    exit 1
fi

provider="${PR_REVIEW_PROVIDER:-}"
case "$provider" in
    codex | claude | gemini) ;;
    *)
        printf 'pr-review-cron: PR_REVIEW_PROVIDER must be codex, claude, or gemini\n' >&2
        exit 2
        ;;
esac

max_failures="${PR_REVIEW_MAX_FAILURES:-3}"
if [[ ! "$max_failures" =~ ^[1-9][0-9]*$ ]]; then
    printf 'pr-review-cron: PR_REVIEW_MAX_FAILURES must be a positive integer\n' >&2
    exit 2
fi

review_path="${PR_REVIEW_PATH:-$PATH}"
if [[ "$review_path" == "CHANGE_ME" ]]; then
    printf 'pr-review-cron: replace PR_REVIEW_PATH=CHANGE_ME with the provider toolchain PATH\n' >&2
    exit 2
fi
export PATH="$HOME/.local/bin:$review_path"
export LC_ALL=C

pr_watch_bin="${PR_REVIEW_WATCH_BIN:-$script_dir/pr-watch}"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/pr-review"
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/pr-review"
work_root="${PR_REVIEW_WORK_ROOT:-$HOME/.local/share/pr-review/work}"
log_file="$state_dir/cron.log"
state_file="$state_dir/pr-watch.seen"
failure_file="$state_dir/provider-failures"
last_alert_file="$state_dir/last-alert-key"
owner="${PR_REVIEW_OWNER:-${PR_WATCH_OWNER:-thelarklan}}"
alert_repo="${PR_REVIEW_ALERT_REPO:-}"
# From this review round on, a reviewer requests changes only for blocking defects.
strict_round="${PR_REVIEW_STRICT_ROUND:-3}"
if [[ ! "$strict_round" =~ ^[1-9][0-9]*$ ]]; then
    printf 'pr-review-cron: PR_REVIEW_STRICT_ROUND must be a positive whole number\n' >&2
    exit 2
fi

mkdir -p -- "$state_dir" "$cache_dir" "$work_root"
touch -- "$log_file" "$state_file" "$failure_file"
if (( $(stat -c %s -- "$log_file") > 5242880 )); then
    tail -n 2000 -- "$log_file" >"$log_file.next"
    mv -f -- "$log_file.next" "$log_file"
fi
exec >>"$log_file" 2>&1

printf '\n[%s] %s watcher started\n' "$(date --iso-8601=seconds)" "$provider"
if [[ ! -x "$pr_watch_bin" ]]; then
    printf 'pr-review-cron: missing watcher executable %s\n' "$pr_watch_bin"
    exit 1
fi

authenticated=$(gh api user --jq '.login') || {
    printf 'pr-review-cron: cannot read the authenticated GitHub identity\n'
    exit 1
}
reviewer="${PR_REVIEW_REVIEWER:-$authenticated}"
if [[ "${authenticated,,}" != "${reviewer,,}" ]]; then
    printf 'pr-review-cron: authenticated as %s, expected %s\n' "$authenticated" "$reviewer"
    exit 1
fi

run_dir=$(mktemp -d "$cache_dir/run.XXXXXXXX")
work_file="$run_dir/work"
error_file="$run_dir/errors"
candidate_state="$run_dir/state.seen"
before_state="$run_dir/state.before"
delta_file="$run_dir/state.delta"
failure_next="$run_dir/provider-failures.next"
provider_out="$run_dir/provider.out"
alert_next="$run_dir/last-alert-key.next"

cleanup() {
    rm -f -- "$work_file" "$error_file" "$candidate_state" "$before_state" \
        "$delta_file" "$failure_next" "$provider_out" "$alert_next" \
        "${candidate_state}.lock"
    rmdir -- "$run_dir" 2>/dev/null || true
}
trap cleanup EXIT HUP INT TERM

sort -u -- "$state_file" >"$before_state"
cp -- "$before_state" "$candidate_state"

set +e
PR_WATCH_STATE="$candidate_state" \
DEV_TOOLS_PR_WATCH_STATE="$candidate_state" \
PR_WATCH_OWNER="$owner" \
PR_WATCH_REVIEWER="$reviewer" \
PR_WATCH_MAX_FOLLOWUPS="${PR_REVIEW_MAX_FOLLOWUPS:-2}" \
PR_WATCH_VERBOSE=1 \
"$pr_watch_bin" >"$work_file" 2>"$error_file"
watch_status=$?
set -e

cat -- "$error_file"
if (( watch_status != 0 )); then
    printf 'pr-review-cron: watcher failed with status %s\n' "$watch_status"
    exit "$watch_status"
fi

sort -u -- "$candidate_state" | comm -13 "$before_state" - >"$delta_file"

commit_item_state() {
    local item="$1"
    awk -v prefix="$item " 'index($0, prefix) == 1' "$delta_file" >>"$state_file"
    sort -u -o "$state_file" -- "$state_file"
}

failure_count() {
    local item="$1" head="$2"
    awk -v item="$item" -v head="$head" '
        $1 == item && $2 == head { print $3; found = 1; exit }
        END { if (!found) print 0 }
    ' "$failure_file"
}

record_failure() {
    local item="$1" head="$2" count
    count=$(failure_count "$item" "$head")
    count=$((count + 1))
    awk -v item="$item" -v head="$head" \
        '!($1 == item && $2 == head)' "$failure_file" >"$failure_next"
    printf '%s %s %s\n' "$item" "$head" "$count" >>"$failure_next"
    mv -f -- "$failure_next" "$failure_file"
    printf '%s\n' "$count"
}

clear_failures() {
    local item="$1" head="$2"
    awk -v item="$item" -v head="$head" \
        '!($1 == item && $2 == head)' "$failure_file" >"$failure_next"
    mv -f -- "$failure_next" "$failure_file"
}

prune_inactive_failures() {
    awk '
        NR == FNR { if (NF) active[$1] = 1; next }
        $1 in active
    ' "$work_file" "$failure_file" >"$failure_next"
    mv -f -- "$failure_next" "$failure_file"
}

prune_other_heads() {
    local item="$1" head="$2"
    awk -v item="$item" -v head="$head" \
        '!($1 == item && $2 != head)' "$failure_file" >"$failure_next"
    mv -f -- "$failure_next" "$failure_file"
}

latest_review() {
    local repo="$1" number="$2"
    gh api --paginate "/repos/$repo/pulls/$number/reviews?per_page=100" \
        --jq ".[] | select(((.user.login // \"\") | ascii_downcase) == \"${reviewer,,}\" and (.state // \"\") != \"DISMISSED\") | [(.id | tostring), (.commit_id // \"\")] | @tsv" \
        | tail -n 1
}

# The review round is 1 + the number of earlier reviews by this reviewer on the pull request.
# Dismissed reviews count too, because a push dismisses stale approvals.
# If the count cannot be read, use round 1 (the normal review bar).
review_round() {
    local repo="$1" number="$2" ids
    if ids=$(gh api --paginate "/repos/$repo/pulls/$number/reviews?per_page=100" \
        --jq ".[] | select(((.user.login // \"\") | ascii_downcase) == \"${reviewer,,}\") | .id"); then
        printf '%s\n' "$(($(grep -c . <<<"$ids" || true) + 1))"
    else
        printf '1\n'
    fi
}

resolve_executable() {
    local configured="$1" fallback="$2"
    if [[ -n "$configured" ]]; then
        if [[ "$configured" == */* ]]; then
            [[ -x "$configured" ]] || return 1
            printf '%s\n' "$configured"
        else
            command -v "$configured"
        fi
    else
        command -v "$fallback"
    fi
}

run_provider() {
    local prompt="$1" executable driver
    local codex_model codex_effort claude_model claude_effort agy_model agy_effort
    local -a codex_args claude_args agy_args

    case "$provider" in
        codex)
            executable=$(resolve_executable "${PR_REVIEW_CODEX_BIN:-}" codex) || {
                printf 'pr-review-cron: Codex CLI is not installed\n' >&2
                return 127
            }
            codex_model="${PR_REVIEW_CODEX_MODEL:-gpt-6.2-sol}"
            codex_effort="${PR_REVIEW_CODEX_EFFORT:-high}"
            codex_args=(
                exec --ephemeral --approve-for-me --skip-git-repo-check
                --model "$codex_model"
            )
            if [[ -n "$codex_effort" ]]; then
                codex_args+=(--config "model_reasoning_effort=\"$codex_effort\"")
            fi
            codex_args+=(-C "$work_root" "$prompt")
            timeout --signal=TERM --kill-after=2m "${PR_REVIEW_TIMEOUT:-45m}" \
                "$executable" "${codex_args[@]}"
            ;;
        claude)
            executable=$(resolve_executable "${PR_REVIEW_CLAUDE_BIN:-}" claude) || {
                printf 'pr-review-cron: Claude CLI is not installed\n' >&2
                return 127
            }
            claude_model="${PR_REVIEW_CLAUDE_MODEL:-claude-opus-5-5}"
            claude_effort="${PR_REVIEW_CLAUDE_EFFORT:-high}"
            claude_args=(
                --print --permission-mode bypassPermissions
                --no-session-persistence --output-format text
                --model "$claude_model"
            )
            if [[ -n "$claude_effort" ]]; then
                claude_args+=(--effort "$claude_effort")
            fi
            claude_args+=("$prompt")
            timeout --signal=TERM --kill-after=2m "${PR_REVIEW_TIMEOUT:-45m}" \
                "$executable" "${claude_args[@]}"
            ;;
        gemini)
            driver="${PR_REVIEW_GEMINI_DRIVER:-agy}"
            case "$driver" in
                gemini)
                    executable=$(resolve_executable "${PR_REVIEW_GEMINI_BIN:-}" gemini) || {
                        printf 'pr-review-cron: Gemini CLI is not installed\n' >&2
                        return 127
                    }
                    timeout --signal=TERM --kill-after=2m "${PR_REVIEW_TIMEOUT:-45m}" \
                        "$executable" --prompt "$prompt" --approval-mode yolo \
                        --output-format text
                    ;;
                agy)
                    executable=$(resolve_executable "${PR_REVIEW_GEMINI_BIN:-}" agy) || {
                        printf 'pr-review-cron: Antigravity CLI (agy) is not installed\n' >&2
                        return 127
                    }
                    agy_model="${PR_REVIEW_ANTIGRAVITY_MODEL:-gemini-4-neon-high}"
                    agy_effort="${PR_REVIEW_ANTIGRAVITY_EFFORT:-}"
                    agy_args=(
                        --dangerously-skip-permissions
                        --output-format text
                        --print-timeout "${PR_REVIEW_TIMEOUT:-45m}"
                        --model "$agy_model"
                    )
                    if [[ -n "$agy_effort" ]]; then
                        agy_args+=(--effort "$agy_effort")
                    fi
                    agy_args+=("--print=$prompt")
                    timeout --signal=TERM --kill-after=2m "${PR_REVIEW_TIMEOUT:-45m}" \
                        "$executable" "${agy_args[@]}"
                    ;;
                *)
                    printf 'pr-review-cron: PR_REVIEW_GEMINI_DRIVER must be gemini or agy\n' >&2
                    return 2
                    ;;
            esac
            ;;
    esac
}

find_health_issue() {
    local title="$1" issues_json
    issues_json=$(gh issue list --repo "$alert_repo" --state open --limit 100 --json number,title) || return 1
    jq -r --arg title "$title" '[.[] | select(.title == $title)] | first | .number // empty' <<<"$issues_json"
}

emit_health_alert() {
    local alert_key="$1" alert_summary="$2"
    local previous_key="" alert_title existing_issue alert_body

    [[ -n "$alert_repo" ]] || return 0
    if [[ -f "$last_alert_file" ]]; then
        previous_key=$(<"$last_alert_file")
    fi
    if [[ "$alert_key" == "$previous_key" ]]; then
        return 0
    fi

    alert_title="[bot-health] $provider ($reviewer) review alert"
    # shellcheck disable=SC2016 # Backticks are Markdown code spans.
    alert_body=$(printf 'Automated health alert for `%s` (`%s`) at `%s`.\n\n%s\n' \
        "$provider" "$reviewer" "$(date --iso-8601=seconds)" "$alert_summary")

    if ! existing_issue=$(find_health_issue "$alert_title"); then
        printf 'pr-review-cron: health alert lookup failed for %s\n' "$alert_repo"
        return 0
    fi

    if [[ -n "$existing_issue" ]]; then
        if ! gh issue comment "$existing_issue" --repo "$alert_repo" --body "$alert_body" >/dev/null; then
            printf 'pr-review-cron: health alert comment failed for %s#%s\n' "$alert_repo" "$existing_issue"
            return 0
        fi
    else
        if ! gh issue create --repo "$alert_repo" --title "$alert_title" --body "$alert_body" >/dev/null; then
            printf 'pr-review-cron: health alert creation failed for %s\n' "$alert_repo"
            return 0
        fi
    fi

    printf '%s\n' "$alert_key" >"$alert_next"
    mv -f -- "$alert_next" "$last_alert_file"
}

resolve_health_alert() {
    local alert_title existing_issue
    [[ -n "$alert_repo" && -f "$last_alert_file" ]] || return 0

    alert_title="[bot-health] $provider ($reviewer) review alert"
    if ! existing_issue=$(find_health_issue "$alert_title"); then
        printf 'pr-review-cron: health alert recovery lookup failed for %s\n' "$alert_repo"
        return 0
    fi

    if [[ -n "$existing_issue" ]]; then
        if ! gh issue close "$existing_issue" --repo "$alert_repo" \
            --comment "Resolved: $provider ($reviewer) completed a clean poll with no active failures or authentication warnings." >/dev/null; then
            printf 'pr-review-cron: health alert close failed for %s#%s\n' "$alert_repo" "$existing_issue"
            return 0
        fi
    fi

    rm -f -- "$last_alert_file"
}

prune_inactive_failures

processed=0
failed=0
paused=0
auth_alert=0
declare -a alert_reasons=()
declare -a alert_lines=()
auth_pattern='Failed to authenticate|Failed to refresh token|sign-in can end|claude auth login|Please log out and sign in again|token expired|invalid_jwt'

while IFS= read -r item; do
    [[ -n "$item" ]] || continue
    if [[ ! "$item" =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+#[0-9]+$ ]]; then
        printf 'pr-review-cron: refusing malformed work item: %s\n' "$item"
        failed=$((failed + 1))
        continue
    fi
    if grep -Fq "ESCALATE: $item " "$error_file"; then
        printf '[%s] %s requires human review; autonomous follow-ups stopped\n' \
            "$(date --iso-8601=seconds)" "$item"
        alert_reasons+=("watch-escalate:$item")
        alert_lines+=("- Escalated from watcher follow-up limit: $item")
        commit_item_state "$item"
        continue
    fi

    repo="${item%#*}"
    number="${item##*#}"
    set +e
    current_head=$(gh pr view "$number" --repo "$repo" --json headRefOid --jq '.headRefOid')
    current_head_status=$?
    before_review=$(latest_review "$repo" "$number")
    before_review_status=$?
    set -e
    if ((current_head_status != 0 || before_review_status != 0)); then
        failed=$((failed + 1))
        printf 'pr-review-cron: preparation query failed for %s (head-status=%s, review-status=%s); provider not started\n' \
            "$item" "$current_head_status" "$before_review_status"
        continue
    fi
    prune_other_heads "$item" "$current_head"
    attempt_count=$(failure_count "$item" "$current_head")
    if ((attempt_count >= max_failures)); then
        paused=$((paused + 1))
        printf '[%s] %s at %s remains paused after %s unconfirmed attempt(s)\n' \
            "$(date --iso-8601=seconds)" "$item" "$current_head" "$attempt_count"
        continue
    fi
    before_review_id="${before_review%%$'\t'*}"
    round=$(review_round "$repo" "$number")
    round_rule="This is your review round $round on this pull request."
    if ((round >= strict_round)); then
        round_rule+=" From round $strict_round on, use REQUEST_CHANGES only for a blocking defect: a wrong result, lost data, a security problem, or a change that breaks a running host or blocks merges. Put every other finding in the review body as a non-blocking suggestion, and submit APPROVE when no blocking defect remains."
    fi
    prompt="$(printf '%s\n' \
        "This is an autonomous scheduled pull-request review for $item, running as GitHub identity $reviewer." \
        "" \
        "Use the GitHub CLI for GitHub reads and the final review submission. Inspect the complete diff, repository instructions, prior review conversation, and relevant surrounding code. Run proportionate tests when feasible. Re-read the pull request head immediately before submitting so no stale review is posted." \
        "" \
        "Before choosing a verdict, perform a separate defect-seeking pass independent of the pull request description and existing CI results. Identify the highest-risk changed behavior, trace its failure and boundary paths, and inspect whether tests could pass while documented behavior still fails. Findings must be concrete and evidence-backed; do not manufacture nits. Treat APPROVE as a conclusion reached only after this pass, not as the default outcome." \
        "" \
        "$round_rule" \
        "" \
        "Submit exactly one new GitHub pull-request review at the current head using APPROVE, COMMENT, or REQUEST_CHANGES as warranted. Do not merely print a review locally. End the review body with this marker on its own line:" \
        "_reviewed from: $provider-wsl-cron_" \
        "" \
        "Do not merge, push commits, modify any branch, mark drafts ready, or approve a self-authored pull request. Keep temporary work under /tmp or $work_root. If a safe review cannot be completed, exit nonzero and explain why instead of submitting a guess.")"

    printf '[%s] reviewing %s at %s\n' "$(date --iso-8601=seconds)" "$item" "$current_head"
    : >"$provider_out"
    set +e
    (cd -- "$work_root" && run_provider "$prompt") >"$provider_out" 2>&1
    provider_status=$?
    set -e
    cat -- "$provider_out"

    if grep -Eiq "$auth_pattern" "$provider_out"; then
        auth_alert=1
        auth_line=$(grep -Eim 1 "$auth_pattern" "$provider_out" | cut -c 1-200)
        alert_reasons+=("auth:$provider")
        alert_lines+=("- Authentication diagnostic for \`$provider\`: \`$auth_line\`")
    fi

    set +e
    after_head=$(gh pr view "$number" --repo "$repo" --json headRefOid --jq '.headRefOid')
    after_head_status=$?
    after_review=$(latest_review "$repo" "$number")
    after_review_status=$?
    set -e
    after_review_id="${after_review%%$'\t'*}"
    after_review_commit="${after_review#*$'\t'}"
    if (( provider_status == 0 && after_head_status == 0 && after_review_status == 0 )) &&
        [[ -n "$after_review_id" ]] &&
        [[ "$after_review_id" != "$before_review_id" ]] &&
        [[ "$after_review_commit" == "$after_head" ]]; then
        commit_item_state "$item"
        clear_failures "$item" "$current_head"
        processed=$((processed + 1))
        printf '[%s] confirmed review %s for %s at %s\n' \
            "$(date --iso-8601=seconds)" "$after_review_id" "$item" "$after_head"
    else
        failed=$((failed + 1))
        attempt_count=$(record_failure "$item" "$current_head")
        if ((after_head_status != 0 || after_review_status != 0)); then
            printf 'pr-review-cron: confirmation query failed for %s (head-status=%s, review-status=%s)\n' \
                "$item" "$after_head_status" "$after_review_status"
        fi
        printf 'pr-review-cron: %s was not confirmed (provider=%s, before=%s, after=%s, head=%s)\n' \
            "$item" "$provider_status" "${before_review_id:-none}" "${after_review_id:-none}" \
            "${after_head:-unknown}"
        if ((attempt_count >= max_failures)); then
            commit_item_state "$item"
            printf 'pr-review-cron: ESCALATE: %s failed %s consecutive attempt(s) at %s; automatic retries paused\n' \
                "$item" "$attempt_count" "$current_head"
            alert_reasons+=("escalate:$item@$current_head")
            alert_lines+=("- Review paused after $attempt_count failure(s): $item at \`$current_head\`")
        fi
    fi
done <"$work_file"

if (( ${#alert_reasons[@]} > 0 )); then
    alert_fingerprint=$(printf '%s\n' "${alert_reasons[@]}" | LC_ALL=C sort -u | paste -sd ',' -)
    alert_summary=$(printf '%s\n' "${alert_lines[@]}" | awk '!seen[$0]++')
    emit_health_alert "$alert_fingerprint" "$alert_summary"
elif (( failed == 0 && paused == 0 && auth_alert == 0 )); then
    resolve_health_alert
fi

printf '[%s] %s watcher finished: %s confirmed, %s failed, %s paused\n' \
    "$(date --iso-8601=seconds)" "$provider" "$processed" "$failed" "$paused"
(( failed == 0 ))
