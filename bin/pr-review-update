#!/usr/bin/env bash
set -euo pipefail

upstream="${PR_REVIEW_UPDATE_UPSTREAM:-https://github.com/thelarklan/pr-review.git}"
remote_name="${PR_REVIEW_UPDATE_REMOTE:-origin}"
branch="${PR_REVIEW_UPDATE_BRANCH:-main}"
source_dir="${PR_REVIEW_UPDATE_SOURCE:-$HOME/projects/repos/pr-review}"
role="${PR_REVIEW_ROLE:-}"
state_dir="${XDG_STATE_HOME:-$HOME/.local/state}/pr-review-update"
cache_dir="${XDG_CACHE_HOME:-$HOME/.cache}/pr-review"
# One lock file, or a space-separated list. The updater holds every lock that a scheduled job uses,
# so it never replaces the checkout while a job runs.
lock_files="${PR_REVIEW_UPDATE_LOCK:-$cache_dir/cron.lock}"
log_file="${PR_REVIEW_UPDATE_LOG:-$state_dir/cron.log}"
deployed_file="${PR_REVIEW_UPDATE_DEPLOYED_STATE:-$state_dir/deployed}"
# The runner holds the shared lock for a full review (up to 45 minutes).
# Wait for it instead of skipping, so a long review cannot block updates.
lock_wait="${PR_REVIEW_UPDATE_LOCK_WAIT:-3000}"
clone_dir=""
verify_dir=""
state_next=""

fail() {
    printf 'pr-review-update: %s\n' "$*" >&2
    exit 1
}

require_absolute_path() {
    local name="$1" value="$2"
    if [[ "$value" != /* || "$value" == "/" ]]; then
        fail "$name must be an absolute path other than /"
    fi
}

cleanup() {
    if [[ -n "$clone_dir" && -d "$clone_dir" ]]; then
        rm -rf -- "$clone_dir"
    fi
    if [[ -n "$verify_dir" && -d "$verify_dir" ]]; then
        rm -rf -- "$verify_dir"
    fi
    if [[ -n "$state_next" ]]; then
        rm -f -- "$state_next"
    fi
}
trap cleanup EXIT HUP INT TERM

[[ -n "$upstream" ]] || fail "PR_REVIEW_UPDATE_UPSTREAM must not be empty"
if [[ ! "$remote_name" =~ ^[A-Za-z0-9._-]+$ ]]; then
    fail "PR_REVIEW_UPDATE_REMOTE must be a valid Git remote name"
fi
if ! git check-ref-format "refs/heads/$branch" >/dev/null 2>&1; then
    fail "PR_REVIEW_UPDATE_BRANCH is not a safe branch name"
fi
if [[ -n "$role" ]]; then
    case "$role" in
        codex | claude | gemini | services) ;;
        *) fail "PR_REVIEW_ROLE must be codex, claude, gemini, or services" ;;
    esac
fi
if [[ ! "$lock_wait" =~ ^(0|[1-9][0-9]*)$ ]]; then
    fail "PR_REVIEW_UPDATE_LOCK_WAIT must be a whole number of seconds"
fi
require_absolute_path PR_REVIEW_UPDATE_SOURCE "$source_dir"
read -r -a lock_list <<<"$lock_files"
((${#lock_list[@]} > 0)) || fail "PR_REVIEW_UPDATE_LOCK must name at least one lock file"
for lock_file in "${lock_list[@]}"; do
    require_absolute_path PR_REVIEW_UPDATE_LOCK "$lock_file"
done
require_absolute_path PR_REVIEW_UPDATE_LOG "$log_file"
require_absolute_path PR_REVIEW_UPDATE_DEPLOYED_STATE "$deployed_file"

mkdir -p -- "$(dirname -- "$source_dir")" "$state_dir" \
    "$(dirname -- "$log_file")" "$(dirname -- "$deployed_file")"
for lock_file in "${lock_list[@]}"; do
    mkdir -p -- "$(dirname -- "$lock_file")"
done
touch -- "$log_file"
if (( $(stat -c %s -- "$log_file") > 5242880 )); then
    tail -n 2000 -- "$log_file" >"$log_file.next"
    mv -f -- "$log_file.next" "$log_file"
fi
exec >>"$log_file" 2>&1

printf '\n[%s] updater started\n' "$(date --iso-8601=seconds)"
if ((lock_wait == 0)); then
    flock_args=(-n)
else
    flock_args=(-w "$lock_wait")
fi
# Take the locks in list order. Each scheduled job takes only one lock, so this order cannot deadlock.
for lock_file in "${lock_list[@]}"; do
    exec {lock_fd}>"$lock_file"
    if ! flock "${flock_args[@]}" "$lock_fd"; then
        printf '[%s] shared lock %s is busy after %ss; update skipped\n' \
            "$(date --iso-8601=seconds)" "$lock_file" "$lock_wait"
        exit 0
    fi
done

if [[ ! -e "$source_dir" ]]; then
    clone_dir=$(mktemp -d "${source_dir}.clone.XXXXXXXX")
    if ! git clone --origin "$remote_name" --branch "$branch" --single-branch \
        --no-tags -- \
        "$upstream" "$clone_dir"; then
        fail "could not clone canonical source"
    fi
    mv -T -- "$clone_dir" "$source_dir"
    clone_dir=""
elif [[ ! -d "$source_dir" ]]; then
    fail "source path exists but is not a directory: $source_dir"
fi

if [[ "$(git -C "$source_dir" rev-parse --is-inside-work-tree 2>/dev/null || true)" != "true" ]]; then
    fail "source path is not a Git worktree: $source_dir"
fi

remote_urls=$(git -C "$source_dir" remote get-url --all "$remote_name" 2>/dev/null || true)
if [[ "$remote_urls" != "$upstream" ]]; then
    fail "$remote_name remote must be exactly $upstream"
fi

current_branch=$(git -C "$source_dir" symbolic-ref --quiet --short HEAD 2>/dev/null || true)
if [[ "$current_branch" != "$branch" ]]; then
    fail "source checkout must be on $branch, found ${current_branch:-detached HEAD}"
fi
if [[ -n "$(git -C "$source_dir" status --porcelain)" ]]; then
    fail "source checkout has local changes"
fi

git -C "$source_dir" fetch --no-tags --prune "$remote_name" \
    "+refs/heads/$branch:refs/remotes/$remote_name/$branch"
current=$(git -C "$source_dir" rev-parse HEAD)
candidate=$(git -C "$source_dir" rev-parse "refs/remotes/$remote_name/$branch^{commit}")
if ! git -C "$source_dir" merge-base --is-ancestor "$current" "$candidate"; then
    fail "canonical $branch is not a fast-forward of deployed source $current"
fi

deployed=""
if [[ -f "$deployed_file" ]]; then
    deployed=$(<"$deployed_file")
fi
if [[ "$current" == "$candidate" && "$deployed" == "$candidate" ]]; then
    printf '[%s] already at verified commit %s\n' "$(date --iso-8601=seconds)" "$candidate"
    exit 0
fi

# Cron runs bin/ directly from the source checkout.
# Verify the candidate in a separate export first, so a failed check never goes live.
verify_dir=$(mktemp -d "${TMPDIR:-/tmp}/pr-review-verify.XXXXXXXX")
git -C "$source_dir" archive --format=tar "$candidate" | tar -x -C "$verify_dir"
[[ -f "$verify_dir/scripts/verify.sh" ]] || fail "candidate $candidate is missing scripts/verify.sh"
[[ -f "$verify_dir/install.sh" ]] || fail "candidate $candidate is missing install.sh"
if ! (cd -- "$verify_dir" && bash scripts/verify.sh); then
    fail "verification failed for $candidate; source stays at $current"
fi
rm -rf -- "$verify_dir"
verify_dir=""

if [[ "$current" != "$candidate" ]]; then
    git -C "$source_dir" merge --ff-only "$candidate"
fi
if [[ -n "$(git -C "$source_dir" status --porcelain)" ]]; then
    fail "source checkout changed during update"
fi

if [[ -n "$role" ]]; then
    bash "$source_dir/install.sh" --role "$role"
fi

state_next=$(mktemp "${deployed_file}.XXXXXXXX")
printf '%s\n' "$candidate" >"$state_next"
mv -f -- "$state_next" "$deployed_file"
state_next=""
printf '[%s] verified and installed %s\n' "$(date --iso-8601=seconds)" "$candidate"
